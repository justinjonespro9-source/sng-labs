{
  "name": "sng-labs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node --conditions react-server --import tsx scripts/v1d-preview-verify.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma generate && tsx prisma/seed.ts",
    "game-day:import-nfl": "prisma generate && tsx scripts/import-nfl-schedule.ts",
    "sports:import-roster": "prisma generate && tsx scripts/import-sports-roster.ts",
    "sports:import-event-stats": "prisma generate && tsx scripts/import-sports-event-stats.ts",
    "sports:prepare-nflverse-week": "prisma generate && tsx scripts/prepare-nflverse-week.ts",
    "sports:cleanup-preview-roster": "prisma generate && tsx scripts/cleanup-preview-roster-import.ts",
    "sports:preview-scoring": "prisma generate && node --conditions react-server --import tsx scripts/preview-nfl-scoring.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^6.19.3",
    "next": "^16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
