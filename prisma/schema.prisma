  newValues      Json
  reason         String?
  playerStat     NflPlayerEventStat?       @relation(fields: [playerStatId], references: [id], onDelete: Restrict)
  defenseStat    NflDefenseEventStat?      @relation(fields: [defenseStatId], references: [id], onDelete: Restrict)
  ingestionRun   SportsIngestionRun        @relation(fields: [ingestionRunId], references: [id], onDelete: Restrict)
  correctedBy    User?                     @relation(fields: [correctedById], references: [id], onDelete: SetNull)
  createdAt      DateTime                  @default(now())

  @@index([playerStatId, createdAt])
  @@index([defenseStatId, createdAt])
  @@index([ingestionRunId])
}

model SportsScoringRuleset {
  id                   String                     @id @default(cuid())
  code                 String
  version              Int
  displayName          String
  sport                String
  league               String?
  status               SportsScoringRulesetStatus @default(DRAFT)
  definition           Json
  definitionChecksum   String                     @unique
  engineFamily         String
  minimumEngineVersion String
  publishedAt          DateTime?
  scoringRuns          SportsScoringRun[]
  derivedPerformances  SportsDerivedPerformance[]
  weeklyResultSets     SportsWeeklyResultSet[]
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  @@unique([code, version])
  @@index([sport, league, status])
}

model SportsScoringRun {
  id                  String                       @id @default(cuid())
  createdById         String?
  seasonId            String
  rulesetId           String
  mode                SportsScoringRunMode
  status              SportsScoringRunStatus       @default(PENDING)
  sport               String
  league              String
  seasonYear          Int
  week                Int
  engineVersion       String
  rulesetChecksum     String
  inputSetChecksum    String
  runFingerprint      String                       @unique
  expectedInputCount  Int                          @default(0)
  calculatedCount     Int                          @default(0)
  resultSetCount      Int                          @default(0)
  unresolvedCount     Int                          @default(0)
  blockedCount        Int                          @default(0)
  errorCount          Int                          @default(0)
  summary             Json?
  completedAt         DateTime?
  createdBy           User?                        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  season              SportsSeason                 @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  ruleset             SportsScoringRuleset         @relation(fields: [rulesetId], references: [id], onDelete: Restrict)
  inputSnapshots      SportsScoringInputSnapshot[]
  derivedPerformances SportsDerivedPerformance[]
  weeklyResultSets    SportsWeeklyResultSet[]
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  @@index([seasonId, week, mode, createdAt])
  @@index([rulesetId, status, createdAt])
}

model SportsScoringInputSnapshot {
  id                        String                    @id @default(cuid())
  scoringRunId              String
  participantId             String
  eventId                   String
  performanceKind           SportsStatPerformanceKind
  sourceEntityType          String
  sourceEntityId            String
  sourceIngestionRunId      String
  sourceRevisionId          String?
  sourceRevisionFingerprint String
  sourceFinality            SportsStatFinality
  normalizedFacts           Json
  inputChecksum             String
  capturedAt                DateTime                  @default(now())
  scoringRun                SportsScoringRun          @relation(fields: [scoringRunId], references: [id], onDelete: Cascade)
  participant               SportsParticipant         @relation(fields: [participantId], references: [id], onDelete: Restrict)
  event                     GrowthEvent               @relation(fields: [eventId], references: [id], onDelete: Restrict)
  derivedPerformance        SportsDerivedPerformance?
  createdAt                 DateTime                  @default(now())

  @@unique([scoringRunId, sourceEntityType, sourceEntityId])
  @@index([participantId, eventId])
  @@index([sourceEntityType, sourceEntityId, sourceRevisionFingerprint])
  @@index([inputChecksum])
}

model SportsDerivedPerformance {
  id                  String                      @id @default(cuid())
  scoringRunId        String
  inputSnapshotId     String                      @unique
  participantId       String
  eventId             String
  rulesetId           String
  engineVersion       String
  rulesetChecksum     String
  pointsHundredths    Int
  fantasyPoints       Decimal                     @db.Decimal(10, 2)
  componentBreakdown  Json
  finality            SportsDerivedResultFinality
  resultFingerprint   String
  calculatedAt        DateTime                    @default(now())
  supersedesId        String?
  scoringRun          SportsScoringRun            @relation(fields: [scoringRunId], references: [id], onDelete: Cascade)
  inputSnapshot       SportsScoringInputSnapshot  @relation(fields: [inputSnapshotId], references: [id], onDelete: Restrict)
  participant         SportsParticipant           @relation(fields: [participantId], references: [id], onDelete: Restrict)
  event               GrowthEvent                 @relation(fields: [eventId], references: [id], onDelete: Restrict)
  ruleset             SportsScoringRuleset        @relation(fields: [rulesetId], references: [id], onDelete: Restrict)
  supersedes          SportsDerivedPerformance?   @relation("DerivedPerformanceLineage", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy        SportsDerivedPerformance[]  @relation("DerivedPerformanceLineage")
  weeklyResultEntries SportsWeeklyResultEntry[]
  createdAt           DateTime                    @default(now())

  @@unique([scoringRunId, resultFingerprint])
  @@index([participantId, eventId, calculatedAt])
  @@index([rulesetId, finality, calculatedAt])
  @@index([supersedesId])
}

model SportsWeeklyResultSet {
  id                       String                      @id @default(cuid())
  scoringRunId             String
  seasonId                 String
  rulesetId                String
  sport                    String
  league                   String
  seasonYear               Int
  week                     Int
  category                 SportsWeeklyResultCategory  @default(POSITION)
  positionCode             String
  eligibilityPolicyVersion String
  inputSetChecksum         String
  resultSetChecksum        String                      @unique
  finality                 SportsDerivedResultFinality
  fieldSize                Int
  sourceComplete           Boolean
  generatedAt              DateTime                    @default(now())
  publishedAt              DateTime?
  scoringRun               SportsScoringRun            @relation(fields: [scoringRunId], references: [id], onDelete: Cascade)
  season                   SportsSeason                @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  ruleset                  SportsScoringRuleset        @relation(fields: [rulesetId], references: [id], onDelete: Restrict)
  entries                  SportsWeeklyResultEntry[]
  createdAt                DateTime                    @default(now())

  @@unique([scoringRunId, category, positionCode])
  @@index([seasonId, week, positionCode])
  @@index([rulesetId, finality, generatedAt])
}

model SportsWeeklyResultEntry {
  id                   String                   @id @default(cuid())
  resultSetId          String
  participantId        String
  derivedPerformanceId String
  positionCode         String
  pointsHundredths     Int
  fantasyPoints        Decimal                  @db.Decimal(10, 2)
  competitionRank      Int
  tieGroupKey          String
  tieGroupSize         Int
  displayOrdinal       Int
  fieldSize            Int
  isTop3               Boolean
  isTop10              Boolean
  isTop15              Boolean
  eligibilityEvidence  Json
  resultSet            SportsWeeklyResultSet    @relation(fields: [resultSetId], references: [id], onDelete: Cascade)
  participant          SportsParticipant        @relation(fields: [participantId], references: [id], onDelete: Restrict)
  derivedPerformance   SportsDerivedPerformance @relation(fields: [derivedPerformanceId], references: [id], onDelete: Restrict)
  createdAt            DateTime                 @default(now())

  @@unique([resultSetId, participantId])
  @@index([resultSetId, competitionRank, displayOrdinal])
  @@index([participantId, resultSetId])
  @@index([derivedPerformanceId])
}

model GenerationRun {
  id                   String                    @id @default(cuid())
  createdById          String?
  brandId              String?
  campaignId           String?
  activationId         String?
  opportunityId        String?
  relationshipId       String?
  eventId              String?
  contentId            String?                   @unique
  channel              String
  audienceSegment      String?
  operatorContext      String?                   @db.Text
  operatorContextTrust OperatorContextTrust?
  resolvedContext      Json
  provider             String?
  model                String?
  generationVersion    String
  recommendation       GenerationRecommendation?
  structuredOutput     Json?
  status               GenerationRunStatus       @default(PENDING)
  errorMessage         String?                   @db.Text
  createdBy            User?                     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  brand                Brand?                    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  campaign             Campaign?                 @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  activation           CampaignActivation?       @relation(fields: [activationId], references: [id], onDelete: SetNull)
  opportunity          Opportunity?              @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  relationship         Relationship?             @relation(fields: [relationshipId], references: [id], onDelete: SetNull)
  event                GrowthEvent?              @relation(fields: [eventId], references: [id], onDelete: SetNull)
  content              ContentDraft?             @relation(fields: [contentId], references: [id], onDelete: SetNull)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@index([createdAt])
  @@index([brandId, createdAt])
  @@index([status, createdAt])
  @@index([eventId, createdAt])
}
