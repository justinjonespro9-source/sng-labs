generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum BrandKind {
  CORPORATE
  PRODUCT
}

enum SocialPlatform {
  X
  INSTAGRAM
  FACEBOOK
  DISCORD
  LINKEDIN
  TIKTOK
  YOUTUBE
  THREADS
  OTHER
}

enum SocialAccountType {
  UNKNOWN
  PROFILE
  PAGE
  PROFESSIONAL_ACCOUNT
  GUILD
  CHANNEL
  WEBHOOK_DESTINATION
  OTHER
}

enum SocialAccountLifecycleStatus {
  KNOWN
  ACTIVE
  INACTIVE
  DISABLED
}

enum SocialPlatformApplicationEnvironment {
  PREVIEW
  PRODUCTION
}

enum SocialPlatformApplicationStatus {
  DISABLED
  CONFIGURED
  RETIRED
}

enum SocialAuthorizationStatus {
  NOT_CONNECTED
  PENDING
  CONNECTED
  EXPIRED
  REAUTHORIZATION_REQUIRED
  REVOKED
  ERROR
  DISABLED
}

enum SocialAuthorizationAccountStatus {
  DISCOVERED
  VERIFIED
  INACCESSIBLE
  DISABLED
}

enum SocialCapability {
  READ_PROFILE
  PUBLISH_TEXT
  PUBLISH_IMAGE
  PUBLISH_VIDEO
  PUBLISH_MULTI_POST
  READ_PUBLICATION
  READ_ANALYTICS
  READ_REPLIES
  MANAGE_COMMUNITY
  RECEIVE_WEBHOOK_EVENTS
}

enum SocialCapabilityState {
  SUPPORTED
  UNSUPPORTED
  UNVERIFIED
  BLOCKED
}

enum SocialConnectionHealthState {
  HEALTHY
  WATCH
  AT_RISK
  DISCONNECTED
  REAUTHORIZATION_REQUIRED
  PERMISSION_MISSING
  API_ERROR
  DISABLED
  UNKNOWN
}

enum SocialConnectionHealthSignal {
  AUTHORIZATION_VALID
  AUTHORIZATION_EXPIRED
  REFRESH_SUCCEEDED
  REFRESH_FAILED
  PERMISSION_LOST
  ACCOUNT_INACCESSIBLE
  API_REQUEST_FAILED
  WEBHOOK_FAILED
  ACCOUNT_DISABLED
  MANUAL_REVIEW
}

enum ConnectionStatus {
  NOT_CONNECTED
  CONNECTED
  NEEDS_ATTENTION
  DISABLED
}

enum PublishingMode {
  MANUAL
  ASSISTED
  SELECTIVE_AUTOPILOT
}

enum OpportunityStatus {
  NEW
  REVIEWED
  DEVELOPING
  QUEUED
  COMPLETE
  NO_POST
  DISMISSED
}

enum DraftStatus {
  DRAFT
  NEEDS_REVIEW
  REVISION_REQUESTED
  APPROVED
  READY
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum ApprovalDecision {
  APPROVED
  REVISION_REQUESTED
  REJECTED
}

enum PublicationStatus {
  PLANNED
  READY
  PUBLISHED
  FAILED
  CANCELLED
}

enum HealthState {
  HEALTHY
  WATCH
  AT_RISK
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum CampaignStatus {
  PLANNING
  ACTIVE
  PAUSED
  COMPLETE
  ARCHIVED
}

enum CampaignObjectiveType {
  USER_ACQUISITION
  PARTICIPATION
  RETENTION
  BRAND_AWARENESS
  CREATOR_ACTIVATION
  MEDIA_EARNED
  PARTNERSHIP
  INDUSTRY_OUTREACH
  PRODUCT_VALIDATION
  OTHER
}

enum ActivationStatus {
  PLANNED
  READY
  ACTIVE
  COMPLETE
  PAUSED
  ARCHIVED
}

enum ActivationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ExecutionType {
  ORGANIC_SOCIAL
  CREATOR_OUTREACH
  MEDIA_OUTREACH
  COMMUNITY
  PARTNERSHIP
  PAID
  PRODUCT_EVENT
  OTHER
}

enum OrganizationType {
  MEDIA
  TEAM
  CREATOR_NETWORK
  CREATOR
  PODCAST
  VENUE
  PARTNER
  AGENCY
  INVESTOR
  OTHER
}

enum RelationshipStage {
  PROSPECT
  CONTACTED
  CONVERSATION
  OPPORTUNITY
  PARTNER
  CLOSED
  NOT_PURSUING
}

enum ActivityType {
  EMAIL
  DM
  CALL
  MEETING
  NOTE
  FOLLOW_UP
  OTHER
}

enum GrowthEventType {
  GAME
  LAUNCH
  LIVE_EVENT
  DEADLINE
  MEDIA_MOMENT
  CAMPAIGN_MILESTONE
  OTHER
}

enum GrowthEventStatus {
  SCHEDULED
  TIME_TBD
  POSTPONED
  CANCELLED
  LIVE
  FINAL
}

enum RecommendationOutcome {
  CREATE_OPPORTUNITY
  SKIP
  NEEDS_CONTEXT
}

enum RecommendationReviewStatus {
  PENDING
  ACCEPTED
  SKIPPED
  DISMISSED
  STALE
}

enum RecommendationNaturalUnit {
  EVENT
  VENUE
  MARKET
  WEEK
  SLATE
  CAMPAIGN
}

enum GenerationRecommendation {
  CREATE
  DO_NOT_POST
  NEEDS_MORE_CONTEXT
}

enum GenerationRunStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum OperatorContextTrust {
  OPERATOR_SUPPLIED
  HYPOTHETICAL
}

enum SportsParticipantKind {
  PLAYER
  TEAM_DEFENSE
}

enum FantasyPosition {
  QB
  RB
  WR
  TE
  DEF
}

enum SportsRosterStatus {
  ACTIVE
  PRACTICE_SQUAD
  INJURED_RESERVE
  PUP
  SUSPENDED
  INACTIVE
  FREE_AGENT
  OTHER
}

enum SportsIngestionType {
  TEAM_DIRECTORY
  VENUE_DIRECTORY
  SCHEDULE
  SCHEDULE_CORRECTION
  PLAYER_DIRECTORY
  SEASON_ROSTER
  PARTICIPANT_IDENTITY
  PLAYER_EVENT_STATS
  DEFENSE_EVENT_STATS
  EVENT_STAT_CORRECTION
}

enum SportsIngestionStatus {
  PREVIEWED
  APPLIED
  FAILED
}

enum SportsIngestionRecordStatus {
  CREATE
  UPDATE
  UNCHANGED
  CONFLICT
  INVALID
  SKIPPED
  UNRESOLVED
  ERROR
}

enum SportsDataQualityIssueType {
  UNRESOLVED_LEAGUE
  UNRESOLVED_TEAM
  UNRESOLVED_VENUE
  DUPLICATE_EVENT
  CONFLICTING_SCHEDULE
  INCOMPLETE_PROVENANCE
  UNRESOLVED_IDENTITY
  AMBIGUOUS_MATCH
  DUPLICATE_CANDIDATE
  MISSING_EXTERNAL_MAPPING
  CONFLICTING_ROSTER_TEAM
  MISSING_EVENT
  PARTICIPANT_TEAM_MISMATCH
  DEFENSE_TEAM_MISMATCH
  DUPLICATE_PERFORMANCE
  CONFLICTING_FACTUAL_INPUT
  INCOMPLETE_EVENT_STATS
  CORRECTED_STAT
}

enum BrandSportsRelevanceScope {
  LEAGUE
  TEAM
  VENUE
  MARKET
}

enum BrandSportsRelevanceStatus {
  ACTIVE
  PAUSED
  RETIRED
}

enum BrandSportsRelevanceSource {
  OPERATOR
  LEGACY_TEAM_LINK
  CAMPAIGN
  ACTIVATION
  RULE
}

enum SportsStatFinality {
  PROVISIONAL
  FINAL
  CORRECTED
  VOID
}

enum SportsPlayerParticipationStatus {
  PARTICIPATED_WITH_STATS
  PARTICIPATED_ZERO
  DID_NOT_PARTICIPATE
  UNKNOWN
}

enum SportsStatPerformanceKind {
  PLAYER
  TEAM_DEFENSE
}

enum SportsDataQualityIssueStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum SportsScoringRulesetStatus {
  DRAFT
  SHADOW
  ACTIVE
  RETIRED
}

enum SportsScoringRunMode {
  PREVIEW
  SHADOW
  PUBLISHED
}

enum SportsScoringRunStatus {
  PENDING
  COMPLETED
  FAILED
}

enum SportsDerivedResultFinality {
  PROVISIONAL
  FINAL
  SUPERSEDED
  VOID
}

enum SportsWeeklyResultCategory {
  POSITION
}

model User {
  id                      String                      @id @default(cuid())
  name                    String?
  email                   String?                     @unique
  emailVerified           DateTime?
  image                   String?
  role                    UserRole                    @default(VIEWER)
  accounts                Account[]
  sessions                Session[]
  approvals               Approval[]
  auditEvents             AuditEvent[]
  relationships           Relationship[]
  generationRuns          GenerationRun[]
  reviewedRecommendations OpportunityRecommendation[] @relation("RecommendationReviewer")
  sportsIngestionRuns     SportsIngestionRun[]
  sportsStatRevisions     SportsStatRevision[]
  sportsScoringRuns       SportsScoringRun[]
  socialAuthorizations    SocialAuthorization[]
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Brand {
  id                         String                      @id @default(cuid())
  key                        String                      @unique
  name                       String
  shortName                  String?
  kind                       BrandKind
  description                String
  purpose                    String?
  corePromise                String?
  coreProposition            String?
  audience                   String
  secondaryAudiences         String[]                    @default([])
  distributionAudiences      String[]                    @default([])
  jobsToBeDone               String[]                    @default([])
  voice                      String
  voiceTraits                String[]                    @default([])
  communicationPatterns      String[]                    @default([])
  primaryCtas                String[]                    @default([])
  relevantUrls               String[]                    @default([])
  terminology                Json?
  objectives                 String[]
  contentPillars             String[]                    @default([])
  preferredContent           String[]
  prohibitedContent          String[]
  factualRequirements        String[]                    @default([])
  affiliationRestrictions    String[]                    @default([])
  contentModes               Json?
  aiOperatingInstructions    String[]                    @default([])
  brandBrainVersion          Int?
  brandBrainConfiguredAt     DateTime?
  callToActionRules          String
  visualDirection            String
  defaultCadenceNotes        String
  active                     Boolean                     @default(true)
  socialAccounts             SocialAccount[]
  angles                     BrandAngle[]
  metricSnapshots            MetricSnapshot[]
  teams                      Team[]                      @relation("BrandTeams")
  campaigns                  Campaign[]                  @relation("BrandCampaigns")
  organizations              Organization[]              @relation("BrandOrganizations")
  relationships              Relationship[]              @relation("BrandRelationships")
  growthPrograms             GrowthProgram[]             @relation("BrandGrowthPrograms")
  activations                CampaignActivation[]        @relation("ActivationBrands")
  generationRuns             GenerationRun[]
  opportunityRecommendations OpportunityRecommendation[]
  sportsRelevancePolicies    BrandSportsRelevance[]
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
}

model Sport {
  id        String   @id @default(cuid())
  key       String   @unique
  code      String   @unique
  name      String
  active    Boolean  @default(true)
  leagues   League[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model League {
  id                 String                   @id @default(cuid())
  sportId            String
  key                String                   @unique
  code               String                   @unique
  name               String
  subdivision        String?
  active             Boolean                  @default(true)
  sport              Sport                    @relation(fields: [sportId], references: [id], onDelete: Restrict)
  seasons            SportsSeason[]
  teams              Team[]
  events             GrowthEvent[]
  ingestionRuns      SportsIngestionRun[]
  externalIdentities LeagueExternalIdentity[]
  relevancePolicies  BrandSportsRelevance[]
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([sportId, active])
}

model LeagueExternalIdentity {
  id              String    @id @default(cuid())
  leagueId        String
  provider        String
  externalId      String
  sourceLabel     String?
  sourceReference String?
  verifiedAt      DateTime?
  league          League    @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([provider, externalId])
  @@unique([leagueId, provider, externalId])
  @@index([leagueId])
}

model SocialAccount {
  id                             String                              @id @default(cuid())
  brandId                        String
  platform                       SocialPlatform
  externalAccountId              String?
  accountType                    SocialAccountType                   @default(UNKNOWN)
  lifecycleStatus                SocialAccountLifecycleStatus        @default(KNOWN)
  handle                         String?
  displayName                    String?
  profileUrl                     String?
  ownershipNotes                 String?                             @db.Text
  metadataVerifiedAt             DateTime?
  lastSuccessfulApiInteractionAt DateTime?
  publishingEnabled              Boolean                             @default(false)
  analyticsEnabled               Boolean                             @default(false)
  communityEnabled               Boolean                             @default(false)
  isDefaultForPlatform           Boolean                             @default(false)
  connectionStatus               ConnectionStatus                    @default(NOT_CONNECTED)
  publishingMode                 PublishingMode                      @default(MANUAL)
  cadenceRules                   Json?
  platformRules                  Json?
  autopilotAllowed               Boolean                             @default(false)
  currentHealth                  HealthState                         @default(HEALTHY)
  brand                          Brand                               @relation(fields: [brandId], references: [id], onDelete: Cascade)
  authorizationLinks             SocialAuthorizationAccount[]
  capabilitySnapshots            SocialCapabilitySnapshot[]
  connectionHealthObservations   SocialConnectionHealthObservation[]
  drafts                         ContentDraft[]
  publications                   Publication[]
  metricSnapshots                MetricSnapshot[]
  healthSnapshots                AccountHealthSnapshot[]
  createdAt                      DateTime                            @default(now())
  updatedAt                      DateTime                            @updatedAt

  @@unique([platform, externalAccountId])
  @@index([brandId, platform, lifecycleStatus])
  @@index([platform, connectionStatus])
}

model SocialPlatformApplication {
  id                    String                               @id @default(cuid())
  key                   String                               @unique
  platform              SocialPlatform
  environment           SocialPlatformApplicationEnvironment
  status                SocialPlatformApplicationStatus      @default(DISABLED)
  providerApplicationId String?
  clientCredentialRef   String?
  signingSecretRef      String?
  callbackPath          String?
  featureFlagKey        String?
  metadata              Json?
  authorizations        SocialAuthorization[]
  createdAt             DateTime                             @default(now())
  updatedAt             DateTime                             @updatedAt

  @@unique([platform, environment, providerApplicationId])
  @@index([platform, environment, status])
}

model SocialAuthorization {
  id                      String                       @id @default(cuid())
  platformApplicationId   String
  authorizedById          String?
  providerAuthorizationId String?
  providerPrincipalId     String?
  status                  SocialAuthorizationStatus    @default(NOT_CONNECTED)
  grantedScopes           String[]                     @default([])
  requiredScopes          String[]                     @default([])
  accessCredentialRef     String?
  refreshCredentialRef    String?
  expiresAt               DateTime?
  refreshCapable          Boolean                      @default(false)
  lastRefreshedAt         DateTime?
  lastValidatedAt         DateTime?
  revokedAt               DateTime?
  reauthorizationReason   String?
  lastErrorCode           String?
  lastErrorMessage        String?                      @db.Text
  lastErrorAt             DateTime?
  platformApplication     SocialPlatformApplication    @relation(fields: [platformApplicationId], references: [id], onDelete: Restrict)
  authorizedBy            User?                        @relation(fields: [authorizedById], references: [id], onDelete: SetNull)
  accounts                SocialAuthorizationAccount[]
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt

  @@unique([platformApplicationId, providerAuthorizationId])
  @@index([platformApplicationId, status, expiresAt])
  @@index([authorizedById, createdAt])
}

model SocialAuthorizationAccount {
  id                       String                              @id @default(cuid())
  authorizationId          String
  socialAccountId          String
  status                   SocialAuthorizationAccountStatus    @default(DISCOVERED)
  providerRelationshipType String?
  providerRoles            String[]                            @default([])
  discoveredAt             DateTime                            @default(now())
  verifiedAt               DateTime?
  lastAccessibleAt         DateTime?
  authorization            SocialAuthorization                 @relation(fields: [authorizationId], references: [id], onDelete: Cascade)
  socialAccount            SocialAccount                       @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  capabilitySnapshots      SocialCapabilitySnapshot[]
  healthObservations       SocialConnectionHealthObservation[]
  createdAt                DateTime                            @default(now())
  updatedAt                DateTime                            @updatedAt

  @@unique([authorizationId, socialAccountId])
  @@index([socialAccountId, status])
}

model SocialCapabilitySnapshot {
  id                     String                     @id @default(cuid())
  authorizationAccountId String
  socialAccountId        String
  adapterVersion         String
  fingerprint            String                     @unique
  verificationMethod     String
  verifiedAt             DateTime                   @default(now())
  validUntil             DateTime
  evidence               Json?
  authorizationAccount   SocialAuthorizationAccount @relation(fields: [authorizationAccountId], references: [id], onDelete: Cascade)
  socialAccount          SocialAccount              @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  results                SocialCapabilityResult[]
  createdAt              DateTime                   @default(now())

  @@index([socialAccountId, validUntil])
  @@index([authorizationAccountId, verifiedAt])
}

model SocialCapabilityResult {
  id             String                   @id @default(cuid())
  snapshotId     String
  capability     SocialCapability
  state          SocialCapabilityState
  requiredScopes String[]                 @default([])
  presentScopes  String[]                 @default([])
  reasonCode     String?
  evidence       Json?
  snapshot       SocialCapabilitySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  createdAt      DateTime                 @default(now())

  @@unique([snapshotId, capability])
  @@index([capability, state])
}

model SocialConnectionHealthObservation {
  id                     String                       @id @default(cuid())
  socialAccountId        String
  authorizationAccountId String?
  state                  SocialConnectionHealthState
  signal                 SocialConnectionHealthSignal
  code                   String
  summary                String
  operatorActionRequired Boolean                      @default(false)
  dedupeKey              String
  observedAt             DateTime                     @default(now())
  resolvedAt             DateTime?
  metadata               Json?
  socialAccount          SocialAccount                @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  authorizationAccount   SocialAuthorizationAccount?  @relation(fields: [authorizationAccountId], references: [id], onDelete: SetNull)
  createdAt              DateTime                     @default(now())

  @@index([socialAccountId, observedAt])
  @@index([operatorActionRequired, resolvedAt, observedAt])
  @@index([dedupeKey, resolvedAt])
}

model SourceEvent {
  id              String        @id @default(cuid())
  externalEventId String
  sourceProduct   String
  eventType       String
  occurredAt      DateTime
  receivedAt      DateTime      @default(now())
  headline        String
  facts           Json
  publicUrl       String?
  significance    Int?
  expiresAt       DateTime?
  schemaVersion   Int           @default(1)
  opportunities   Opportunity[]

  @@unique([sourceProduct, externalEventId])
  @@index([occurredAt])
}

model Opportunity {
  id                     String                     @id @default(cuid())
  sourceEventId          String?
  activationId           String?
  eventId                String?
  title                  String
  summary                String
  whyItMatters           String?
  status                 OpportunityStatus          @default(NEW)
  urgency                Int                        @default(0)
  confidence             Float?
  recommendedAt          DateTime?
  expiresAt              DateTime?
  noPostRationale        String?
  actionRecommendation   String?
  sourceLabel            String?
  sourceEvent            SourceEvent?               @relation(fields: [sourceEventId], references: [id], onDelete: SetNull)
  activation             CampaignActivation?        @relation(fields: [activationId], references: [id], onDelete: SetNull)
  event                  GrowthEvent?               @relation(fields: [eventId], references: [id], onDelete: SetNull)
  angles                 BrandAngle[]
  campaigns              CampaignOpportunity[]
  markets                Market[]                   @relation("MarketOpportunities")
  teams                  Team[]                     @relation("TeamOpportunities")
  generationRuns         GenerationRun[]
  acceptedRecommendation OpportunityRecommendation? @relation("AcceptedOpportunity")
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  @@index([status, recommendedAt])
  @@index([activationId, status])
  @@index([eventId, status])
}

model BrandAngle {
  id              String         @id @default(cuid())
  opportunityId   String
  brandId         String
  objective       String
  hook            String
  rationale       String
  suggestedVisual String?
  timingNotes     String?
  riskNotes       String?
  similarityRisk  Float?
  opportunity     Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  brand           Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  drafts          ContentDraft[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([opportunityId, brandId])
}

model ContentDraft {
  id              String         @id @default(cuid())
  brandAngleId    String
  socialAccountId String?
  status          DraftStatus    @default(DRAFT)
  objective       String
  hook            String
  rationale       String
  body            String         @db.Text
  visualBrief     String?        @db.Text
  callToAction    String?
  modelProvider   String?
  modelName       String?
  promptVersion   String?
  sourceFacts     Json?
  aiConfidence    Float?
  scheduledFor    DateTime?
  brandAngle      BrandAngle     @relation(fields: [brandAngleId], references: [id], onDelete: Cascade)
  socialAccount   SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  approvals       Approval[]
  publication     Publication?
  generationRun   GenerationRun?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status, scheduledFor])
}

model Approval {
  id         String           @id @default(cuid())
  draftId    String
  reviewerId String
  decision   ApprovalDecision
  comment    String?
  draft      ContentDraft     @relation(fields: [draftId], references: [id], onDelete: Cascade)
  reviewer   User             @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
  createdAt  DateTime         @default(now())

  @@index([draftId, createdAt])
}

model Publication {
  id              String            @id @default(cuid())
  draftId         String            @unique
  socialAccountId String
  status          PublicationStatus @default(PLANNED)
  scheduledFor    DateTime?
  publishedAt     DateTime?
  platformPostId  String?
  platformUrl     String?
  failureReason   String?
  draft           ContentDraft      @relation(fields: [draftId], references: [id], onDelete: Cascade)
  socialAccount   SocialAccount     @relation(fields: [socialAccountId], references: [id], onDelete: Restrict)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model Campaign {
  id                         String                      @id @default(cuid())
  key                        String?                     @unique
  programId                  String?
  name                       String
  description                String?
  objective                  String?
  objectiveType              CampaignObjectiveType       @default(OTHER)
  primaryAudience            String?
  primaryCta                 String?
  coreMessage                String?
  sport                      String?
  season                     String?
  notes                      String?                     @db.Text
  successDefinition          String?                     @db.Text
  kpis                       String[]                    @default([])
  status                     CampaignStatus              @default(PLANNING)
  startsAt                   DateTime?
  endsAt                     DateTime?
  active                     Boolean                     @default(true)
  program                    GrowthProgram?              @relation(fields: [programId], references: [id], onDelete: SetNull)
  activations                CampaignActivation[]
  opportunities              CampaignOpportunity[]
  brands                     Brand[]                     @relation("BrandCampaigns")
  markets                    Market[]                    @relation("MarketCampaigns")
  teams                      Team[]                      @relation("TeamCampaigns")
  events                     GrowthEvent[]               @relation("CampaignEvents")
  organizations              Organization[]              @relation("CampaignOrganizations")
  relationships              Relationship[]
  activities                 RelationshipActivity[]
  attribution                CampaignAttribution[]
  generationRuns             GenerationRun[]
  opportunityRecommendations OpportunityRecommendation[]
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt

  @@index([programId, status])
}

model GrowthProgram {
  id                   String         @id @default(cuid())
  key                  String         @unique
  name                 String
  description          String
  operatingDescription String?        @db.Text
  status               CampaignStatus @default(ACTIVE)
  brands               Brand[]        @relation("BrandGrowthPrograms")
  campaigns            Campaign[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

model CampaignActivation {
  id                         String                      @id @default(cuid())
  key                        String?                     @unique
  campaignId                 String
  name                       String
  status                     ActivationStatus            @default(PLANNED)
  priority                   ActivationPriority          @default(MEDIUM)
  marketId                   String?
  teamId                     String?
  eventId                    String?
  venueName                  String?
  venueId                    String?
  sport                      String?
  season                     String?
  week                       Int?
  slateLabel                 String?
  audienceSegment            String?
  coreMessage                String?                     @db.Text
  callToAction               String?
  objective                  String?                     @db.Text
  startsAt                   DateTime?
  endsAt                     DateTime?
  notes                      String?                     @db.Text
  campaign                   Campaign                    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  market                     Market?                     @relation(fields: [marketId], references: [id], onDelete: SetNull)
  team                       Team?                       @relation(fields: [teamId], references: [id], onDelete: SetNull)
  event                      GrowthEvent?                @relation(fields: [eventId], references: [id], onDelete: SetNull)
  venue                      Venue?                      @relation(fields: [venueId], references: [id], onDelete: SetNull)
