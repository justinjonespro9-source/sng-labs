generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum BrandKind {
  CORPORATE
  PRODUCT
}

enum SocialPlatform {
  X
  INSTAGRAM
  FACEBOOK
  LINKEDIN
  TIKTOK
  YOUTUBE
  THREADS
  OTHER
}

enum ConnectionStatus {
  NOT_CONNECTED
  CONNECTED
  NEEDS_ATTENTION
  DISABLED
}

enum PublishingMode {
  MANUAL
  ASSISTED
  SELECTIVE_AUTOPILOT
}

enum OpportunityStatus {
  NEW
  REVIEWED
  DEVELOPING
  QUEUED
  COMPLETE
  NO_POST
  DISMISSED
}

enum DraftStatus {
  DRAFT
  NEEDS_REVIEW
  REVISION_REQUESTED
  APPROVED
  READY
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum ApprovalDecision {
  APPROVED
  REVISION_REQUESTED
  REJECTED
}

enum PublicationStatus {
  PLANNED
  READY
  PUBLISHED
  FAILED
  CANCELLED
}

enum HealthState {
  HEALTHY
  WATCH
  AT_RISK
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum CampaignStatus {
  PLANNING
  ACTIVE
  PAUSED
  COMPLETE
  ARCHIVED
}

enum CampaignObjectiveType {
  USER_ACQUISITION
  PARTICIPATION
  RETENTION
  BRAND_AWARENESS
  CREATOR_ACTIVATION
  MEDIA_EARNED
  PARTNERSHIP
  INDUSTRY_OUTREACH
  PRODUCT_VALIDATION
  OTHER
}

enum ActivationStatus {
  PLANNED
  READY
  ACTIVE
  COMPLETE
  PAUSED
  ARCHIVED
}

enum ActivationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ExecutionType {
  ORGANIC_SOCIAL
  CREATOR_OUTREACH
  MEDIA_OUTREACH
  COMMUNITY
  PARTNERSHIP
  PAID
  PRODUCT_EVENT
  OTHER
}

enum OrganizationType {
  MEDIA
  TEAM
  CREATOR_NETWORK
  CREATOR
  PODCAST
  VENUE
  PARTNER
  AGENCY
  INVESTOR
  OTHER
}

enum RelationshipStage {
  PROSPECT
  CONTACTED
  CONVERSATION
  OPPORTUNITY
  PARTNER
  CLOSED
  NOT_PURSUING
}

enum ActivityType {
  EMAIL
  DM
  CALL
  MEETING
  NOTE
  FOLLOW_UP
  OTHER
}

enum GrowthEventType {
  GAME
  LAUNCH
  LIVE_EVENT
  DEADLINE
  MEDIA_MOMENT
  CAMPAIGN_MILESTONE
  OTHER
}

enum GenerationRecommendation {
  CREATE
  DO_NOT_POST
  NEEDS_MORE_CONTEXT
}

enum GenerationRunStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum OperatorContextTrust {
  OPERATOR_SUPPLIED
  HYPOTHETICAL
}

model User {
  id             String          @id @default(cuid())
  name           String?
  email          String?         @unique
  emailVerified  DateTime?
  image          String?
  role           UserRole        @default(VIEWER)
  accounts       Account[]
  sessions       Session[]
  approvals      Approval[]
  auditEvents    AuditEvent[]
  relationships  Relationship[]
  generationRuns GenerationRun[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Brand {
  id                      String               @id @default(cuid())
  key                     String               @unique
  name                    String
  shortName               String?
  kind                    BrandKind
  description             String
  purpose                 String?
  corePromise             String?
  coreProposition         String?
  audience                String
  secondaryAudiences      String[]             @default([])
  distributionAudiences   String[]             @default([])
  jobsToBeDone            String[]             @default([])
  voice                   String
  voiceTraits             String[]             @default([])
  communicationPatterns   String[]             @default([])
  primaryCtas             String[]             @default([])
  relevantUrls            String[]             @default([])
  terminology             Json?
  objectives              String[]
  contentPillars          String[]             @default([])
  preferredContent        String[]
  prohibitedContent       String[]
  factualRequirements     String[]             @default([])
  affiliationRestrictions String[]             @default([])
  contentModes            Json?
  aiOperatingInstructions String[]             @default([])
  brandBrainVersion       Int?
  brandBrainConfiguredAt  DateTime?
  callToActionRules       String
  visualDirection         String
  defaultCadenceNotes     String
  active                  Boolean              @default(true)
  socialAccounts          SocialAccount[]
  angles                  BrandAngle[]
  metricSnapshots         MetricSnapshot[]
  teams                   Team[]               @relation("BrandTeams")
  campaigns               Campaign[]           @relation("BrandCampaigns")
  organizations           Organization[]       @relation("BrandOrganizations")
  relationships           Relationship[]       @relation("BrandRelationships")
  growthPrograms          GrowthProgram[]      @relation("BrandGrowthPrograms")
  activations             CampaignActivation[] @relation("ActivationBrands")
  generationRuns          GenerationRun[]
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
}

model SocialAccount {
  id               String                  @id @default(cuid())
  brandId          String
  platform         SocialPlatform
  handle           String?
  profileUrl       String?
  connectionStatus ConnectionStatus        @default(NOT_CONNECTED)
  publishingMode   PublishingMode          @default(MANUAL)
  cadenceRules     Json?
  platformRules    Json?
  autopilotAllowed Boolean                 @default(false)
  currentHealth    HealthState             @default(HEALTHY)
  brand            Brand                   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  drafts           ContentDraft[]
  publications     Publication[]
  metricSnapshots  MetricSnapshot[]
  healthSnapshots  AccountHealthSnapshot[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@unique([brandId, platform])
  @@index([platform, connectionStatus])
}

model SourceEvent {
  id              String        @id @default(cuid())
  externalEventId String
  sourceProduct   String
  eventType       String
  occurredAt      DateTime
  receivedAt      DateTime      @default(now())
  headline        String
  facts           Json
  publicUrl       String?
  significance    Int?
  expiresAt       DateTime?
  schemaVersion   Int           @default(1)
  opportunities   Opportunity[]

  @@unique([sourceProduct, externalEventId])
  @@index([occurredAt])
}

model Opportunity {
  id                   String                @id @default(cuid())
  sourceEventId        String?
  activationId         String?
  title                String
  summary              String
  whyItMatters         String?
  status               OpportunityStatus     @default(NEW)
  urgency              Int                   @default(0)
  confidence           Float?
  recommendedAt        DateTime?
  expiresAt            DateTime?
  noPostRationale      String?
  actionRecommendation String?
  sourceLabel          String?
  sourceEvent          SourceEvent?          @relation(fields: [sourceEventId], references: [id], onDelete: SetNull)
  activation           CampaignActivation?   @relation(fields: [activationId], references: [id], onDelete: SetNull)
  angles               BrandAngle[]
  campaigns            CampaignOpportunity[]
  markets              Market[]              @relation("MarketOpportunities")
  teams                Team[]                @relation("TeamOpportunities")
  generationRuns       GenerationRun[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([status, recommendedAt])
  @@index([activationId, status])
}

model BrandAngle {
  id              String         @id @default(cuid())
  opportunityId   String
  brandId         String
  objective       String
  hook            String
  rationale       String
  suggestedVisual String?
  timingNotes     String?
  riskNotes       String?
  similarityRisk  Float?
  opportunity     Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  brand           Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  drafts          ContentDraft[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([opportunityId, brandId])
}

model ContentDraft {
  id              String         @id @default(cuid())
  brandAngleId    String
  socialAccountId String?
  status          DraftStatus    @default(DRAFT)
  objective       String
  hook            String
  rationale       String
  body            String         @db.Text
  visualBrief     String?        @db.Text
  callToAction    String?
  modelProvider   String?
  modelName       String?
  promptVersion   String?
  sourceFacts     Json?
  aiConfidence    Float?
  scheduledFor    DateTime?
  brandAngle      BrandAngle     @relation(fields: [brandAngleId], references: [id], onDelete: Cascade)
  socialAccount   SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  approvals       Approval[]
  publication     Publication?
  generationRun   GenerationRun?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status, scheduledFor])
}

model Approval {
  id         String           @id @default(cuid())
  draftId    String
  reviewerId String
  decision   ApprovalDecision
  comment    String?
  draft      ContentDraft     @relation(fields: [draftId], references: [id], onDelete: Cascade)
  reviewer   User             @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
  createdAt  DateTime         @default(now())

  @@index([draftId, createdAt])
}

model Publication {
  id              String            @id @default(cuid())
  draftId         String            @unique
  socialAccountId String
  status          PublicationStatus @default(PLANNED)
  scheduledFor    DateTime?
  publishedAt     DateTime?
  platformPostId  String?
  platformUrl     String?
  failureReason   String?
  draft           ContentDraft      @relation(fields: [draftId], references: [id], onDelete: Cascade)
  socialAccount   SocialAccount     @relation(fields: [socialAccountId], references: [id], onDelete: Restrict)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model Campaign {
  id                String                 @id @default(cuid())
  key               String?                @unique
  programId         String?
  name              String
  description       String?
  objective         String?
  objectiveType     CampaignObjectiveType  @default(OTHER)
  primaryAudience   String?
  primaryCta        String?
  coreMessage       String?
  sport             String?
  season            String?
  notes             String?                @db.Text
  successDefinition String?                @db.Text
  kpis              String[]               @default([])
  status            CampaignStatus         @default(PLANNING)
  startsAt          DateTime?
  endsAt            DateTime?
  active            Boolean                @default(true)
  program           GrowthProgram?         @relation(fields: [programId], references: [id], onDelete: SetNull)
  activations       CampaignActivation[]
  opportunities     CampaignOpportunity[]
  brands            Brand[]                @relation("BrandCampaigns")
  markets           Market[]               @relation("MarketCampaigns")
  teams             Team[]                 @relation("TeamCampaigns")
  events            GrowthEvent[]          @relation("CampaignEvents")
  organizations     Organization[]         @relation("CampaignOrganizations")
  relationships     Relationship[]
  activities        RelationshipActivity[]
  attribution       CampaignAttribution[]
  generationRuns    GenerationRun[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([programId, status])
}

model GrowthProgram {
  id                   String         @id @default(cuid())
  key                  String         @unique
  name                 String
  description          String
  operatingDescription String?        @db.Text
  status               CampaignStatus @default(ACTIVE)
  brands               Brand[]        @relation("BrandGrowthPrograms")
  campaigns            Campaign[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

model CampaignActivation {
  id              String                 @id @default(cuid())
  key             String?                @unique
  campaignId      String
  name            String
  status          ActivationStatus       @default(PLANNED)
  priority        ActivationPriority     @default(MEDIUM)
  marketId        String?
  teamId          String?
  eventId         String?
  venueName       String?
  sport           String?
  season          String?
  week            Int?
  slateLabel      String?
  audienceSegment String?
  coreMessage     String?                @db.Text
  callToAction    String?
  objective       String?                @db.Text
  startsAt        DateTime?
  endsAt          DateTime?
  notes           String?                @db.Text
  campaign        Campaign               @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  market          Market?                @relation(fields: [marketId], references: [id], onDelete: SetNull)
  team            Team?                  @relation(fields: [teamId], references: [id], onDelete: SetNull)
  event           GrowthEvent?           @relation(fields: [eventId], references: [id], onDelete: SetNull)
  brands          Brand[]                @relation("ActivationBrands")
  relationships   Relationship[]         @relation("ActivationRelationships")
  opportunities   Opportunity[]
  activities      RelationshipActivity[]
  generationRuns  GenerationRun[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([campaignId, status, startsAt])
  @@index([marketId, teamId])
  @@index([sport, season, week])
}

model Market {
  id            String               @id @default(cuid())
  key           String               @unique
  name          String
  region        String?
  country       String               @default("US")
  notes         String?
  active        Boolean              @default(true)
  teams         Team[]
  organizations Organization[]
  events        GrowthEvent[]
  campaigns     Campaign[]           @relation("MarketCampaigns")
  opportunities Opportunity[]        @relation("MarketOpportunities")
  activations   CampaignActivation[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model Team {
  id            String               @id @default(cuid())
  key           String               @unique
  name          String
  marketId      String
  sport         String
  league        String
  venueName     String?
  websiteUrl    String?
  notes         String?
  active        Boolean              @default(true)
  market        Market               @relation(fields: [marketId], references: [id], onDelete: Restrict)
  brands        Brand[]              @relation("BrandTeams")
  campaigns     Campaign[]           @relation("TeamCampaigns")
  organizations Organization[]       @relation("OrganizationTeams")
  opportunities Opportunity[]        @relation("TeamOpportunities")
  events        GrowthEvent[]        @relation("TeamEvents")
  activations   CampaignActivation[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([marketId, league])
}

model GrowthEvent {
  id          String               @id @default(cuid())
  name        String
  type        GrowthEventType
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  venueName   String?
  publicUrl   String?
  marketId    String?
  market      Market?              @relation(fields: [marketId], references: [id], onDelete: SetNull)
  teams       Team[]               @relation("TeamEvents")
  campaigns   Campaign[]           @relation("CampaignEvents")
  activations CampaignActivation[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([startsAt, type])
}

model Organization {
  id             String           @id @default(cuid())
  name           String           @unique
  type           OrganizationType
  marketId       String?
  websiteUrl     String?
  notes          String?
  market         Market?          @relation(fields: [marketId], references: [id], onDelete: SetNull)
  teams          Team[]           @relation("OrganizationTeams")
  relevantBrands Brand[]          @relation("BrandOrganizations")
  campaigns      Campaign[]       @relation("CampaignOrganizations")
  contacts       Contact[]
  relationships  Relationship[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([marketId, type])
}

model Contact {
  id             String                 @id @default(cuid())
  name           String
  title          String?
  organizationId String?
  email          String?
  socialHandle   String?
  profileUrl     String?
  notes          String?
  organization   Organization?          @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  relationships  Relationship[]
  activities     RelationshipActivity[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([organizationId, name])
}

model Relationship {
  id             String                 @id @default(cuid())
  name           String
  stage          RelationshipStage      @default(PROSPECT)
  organizationId String
  contactId      String?
  ownerId        String?
  campaignId     String?
  summary        String?
  lastOutreachAt DateTime?
  nextFollowUpAt DateTime?
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact        Contact?               @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner          User?                  @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  campaign       Campaign?              @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  relevantBrands Brand[]                @relation("BrandRelationships")
  activations    CampaignActivation[]   @relation("ActivationRelationships")
  activities     RelationshipActivity[]
  generationRuns GenerationRun[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([stage, nextFollowUpAt])
  @@index([organizationId, updatedAt])
}

model RelationshipActivity {
  id             String              @id @default(cuid())
  relationshipId String
  contactId      String?
  campaignId     String?
  activationId   String?
  executionType  ExecutionType?
  type           ActivityType
  occurredAt     DateTime            @default(now())
  summary        String
  nextStep       String?
  relationship   Relationship        @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  contact        Contact?            @relation(fields: [contactId], references: [id], onDelete: SetNull)
  campaign       Campaign?           @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  activation     CampaignActivation? @relation(fields: [activationId], references: [id], onDelete: SetNull)
  createdAt      DateTime            @default(now())

  @@index([relationshipId, occurredAt])
  @@index([campaignId, activationId, occurredAt])
}

model CampaignAttribution {
  id             String   @id @default(cuid())
  campaignId     String
  capturedAt     DateTime @default(now())
  source         String?
  medium         String?
  campaignCode   String?
  visits         Int      @default(0)
  signups        Int      @default(0)
  conversions    Int      @default(0)
  productActions Json?
  notes          String?
  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, capturedAt])
}

model CampaignOpportunity {
  campaignId    String
  opportunityId String
  campaign      Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@id([campaignId, opportunityId])
}

model MetricSnapshot {
  id               String        @id @default(cuid())
  brandId          String
  socialAccountId  String
  capturedAt       DateTime
  periodStart      DateTime
  periodEnd        DateTime
  followers        Int?
  impressions      Int?
  reach            Int?
  followerReach    Int?
  nonFollowerReach Int?
  engagements      Int?
  postsPublished   Int?
  rawMetrics       Json?
  brand            Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  socialAccount    SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([socialAccountId, capturedAt, periodStart, periodEnd])
  @@index([brandId, capturedAt])
}

model AccountHealthSnapshot {
  id                     String        @id @default(cuid())
  socialAccountId        String
  state                  HealthState
  score                  Int?
  reachTrendPercent      Float?
  engagementTrendPercent Float?
  nonFollowerShare       Float?
  cadenceVariance        Float?
  reasons                String[]
  recommendedActions     String[]
  calculatedAt           DateTime      @default(now())
  socialAccount          SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@index([socialAccountId, calculatedAt])
}

model Job {
  id          String    @id @default(cuid())
  type        String
  status      JobStatus @default(PENDING)
  payload     Json
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  runAfter    DateTime  @default(now())
  lockedAt    DateTime?
  completedAt DateTime?
  lastError   String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAfter])
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model GenerationRun {
  id                   String                    @id @default(cuid())
  createdById          String?
  brandId              String?
  campaignId           String?
  activationId         String?
  opportunityId        String?
  relationshipId       String?
  contentId            String?                   @unique
  channel              String
  audienceSegment      String?
  operatorContext      String?                   @db.Text
  operatorContextTrust OperatorContextTrust?
  resolvedContext      Json
  provider             String?
  model                String?
  generationVersion    String
  recommendation       GenerationRecommendation?
  structuredOutput     Json?
  status               GenerationRunStatus       @default(PENDING)
  errorMessage         String?                   @db.Text
  createdBy            User?                     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  brand                Brand?                    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  campaign             Campaign?                 @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  activation           CampaignActivation?       @relation(fields: [activationId], references: [id], onDelete: SetNull)
  opportunity          Opportunity?              @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  relationship         Relationship?             @relation(fields: [relationshipId], references: [id], onDelete: SetNull)
  content              ContentDraft?             @relation(fields: [contentId], references: [id], onDelete: SetNull)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@index([createdAt])
  @@index([brandId, createdAt])
  @@index([status, createdAt])
}
